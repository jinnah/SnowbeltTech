# Keep the build context small and the image free of things the site does not
# serve. Most of the repo is design-process baggage.

.git
.gitignore
.github/

# Design-process leftovers - roughly 5 MB of pasted screenshots.
uploads/
scraps/
.thumbnail

# Unrelated "Organic" design system that came along in the Claude Design export.
_ds/

# Sources for the OG card and favicon. Used to regenerate those PNGs by hand;
# never served.
_build/

# The Claude Design round-trip copy of index.html. See the Dockerfile.
*.dc.html

# Docs and container plumbing do not belong in the image.
README.md
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml

# Server config. .env in particular must never reach an image layer.
.env
.env.example

# Local scratch
.playwright-mcp/
*.log
