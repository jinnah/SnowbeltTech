# Copy to .env and fill in:   cp .env.example .env
#
# .env is gitignored - it is per-server config, not source.

# ---------------------------------------------------------------------------
# HTTPS (used by:  docker compose --profile tls up -d)
# ---------------------------------------------------------------------------

# The domain the site is served on. Its DNS A/AAAA record must already point
# at this server before you start the tls profile, or Caddy cannot complete
# the ACME challenge and certificate issuance will fail.
#
# Use the apex or the www form - whichever you use here must match the
# canonical URL and og:url in index.html, or you advertise one and serve the
# other.
SITE_DOMAIN=snowbelttech.com

# Where Let's Encrypt sends certificate-expiry warnings.
ACME_EMAIL=hello@snowbelttech.com

# With the tls profile, keep the origin bound to loopback so the site is only
# reachable over HTTPS through Caddy. Without this the plain-HTTP origin stays
# exposed on port 8080.
HTTP_PORT=127.0.0.1:8080

# ---------------------------------------------------------------------------
# HTTP only (used by:  docker compose up -d)
# ---------------------------------------------------------------------------
# Comment out the HTTP_PORT above and use one of these instead.
#
# HTTP_PORT=8080     # default - safe on a VPS that already runs a web server
# HTTP_PORT=80       # serve directly on port 80, no TLS
